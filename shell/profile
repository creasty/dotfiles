# shellcheck shell=sh

#  General
#-----------------------------------------------
export LANG=en_US.UTF-8
export LC_ALL=$LANG

export EDITOR=nvim
export LSCOLORS=Gxfxcxdxbxegedabagacad

#  Search path
#-----------------------------------------------
# Locals
export PATH="$HOME/bin:/usr/local/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Dotfiles
export DOTFILES_PATH="$HOME/dotfiles"
export PATH="$DOTFILES_PATH/bin:$PATH"

# Golang
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

# Rust
export PATH="$PATH:$HOME/.cargo/bin"

# libpq
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Dart
export PATH="$PATH:$HOME/.pub-cache/bin"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PATH:$PNPM_HOME"

#  Homebrew (no not edit)
#-----------------------------------------------
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

#  Nix
#-----------------------------------------------
# In front of Homebrew, so that its formulae don't shadow Nix's packages
export PATH="/etc/profiles/per-user/${USER:-$(id -un)}/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:$PATH"

#  App config
#-----------------------------------------------
# Git
export GIT_MERGE_AUTOEDIT=no

# Rails
export DISABLE_SPRING=1

# Rust
export RUST_BACKTRACE=1
# ...for panics only: capturing a backtrace for every error makes Rust CLIs (e.g. mise) ~80ms slower
export RUST_LIB_BACKTRACE=0

# Create React App
export BROWSER=none

# ripgrep
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# Android
export ANDROID_HOME="$HOME/Library/Android/sdk"

#  mise
#-----------------------------------------------
# Shims for non-interactive shells; interactive zsh activates mise in .zshrc
export PATH="$HOME/.local/share/mise/shims:$PATH"
