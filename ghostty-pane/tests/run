#!/usr/bin/env bash
# End-to-end tests of ghostty-pane, with tmux as the terminal in place of Ghostty, and tests/nvim as Neovim. They build
# ghostty-pane.c with cc, unless given a build:
#
#   nix shell --inputs-from . nixpkgs#tmux --command ghostty-pane/tests/run [<ghostty-pane>]
#
# shellcheck disable=SC2317 # the tests run by their name, from declare -F
set -u

tests_dir="$(cd "$(dirname "$0")" && pwd)"
work="$(mktemp -d)"
case_dir="$work/case"
log="$case_dir/nvim.log"

t() {
  tmux -L "ghostty-pane-tests-$$" -f /dev/null "$@"
}
trap 't kill-server 2> /dev/null; rm -rf "$work"' EXIT

pane="${1:-$work/ghostty-pane}"
if [ $# -eq 0 ]; then
  cc -O2 -Wall -Wextra -Werror -o "$pane" "$tests_dir/../ghostty-pane.c" || exit 1
fi

#  Helpers
#-----------------------------------------------
# Runs the program on stdin through ghostty-pane, in a pane of 100x30, with the fake Neovim
start() {
  t kill-server 2> /dev/null
  rm -rf "$case_dir"
  mkdir -p "$case_dir/tmp"
  : > "$log"
  cat > "$case_dir/program"
  # As Ghostty starts its command, with bash's exec -l, when $login is set
  set -- "$pane"
  # shellcheck disable=SC2016 # bash's
  [ -n "${login:-}" ] && set -- /bin/bash -c 'exec -l "$0" "$@"' "$pane"
  # With env: tmux gives new sessions its client's PATH
  t start-server \; set-option -g remain-on-exit on \; new-session -d -x 100 -y 30 \
    env "HOME=$case_dir" "TMPDIR=$case_dir/tmp" SHELL=/bin/sh "PATH=$tests_dir:$PATH" "FAKE_NVIM_LOG=$log" \
    "$@" /bin/sh -c ". '$case_dir/program'"
}

# The screen, with its history
screen() {
  t capture-pane -p -S -
}

# Waits for a line of the screen to match the pattern (grep's -E), or to have the text with a third argument, for up
# to the tenths of a second given (10 seconds)
wait_for() {
  local i mode=-E
  [ -n "${3:-}" ] && mode=-F
  for ((i = 0; i < ${2:-100}; i++)); do
    screen | grep -q "$mode" -- "$1" && return 0
    sleep 0.1
  done
  echo "timed out waiting for: $1"
  screen | sed 's/^/  | /'
  return 1
}

# Waits for tmux's format to give the value
wait_for_format() {
  local i
  for ((i = 0; i < 100; i++)); do
    [ "$(t display-message -p "$1")" = "$2" ] && return 0
    sleep 0.1
  done
  expect_eq "$(t display-message -p "$1")" "$2" "$1"
}

wait_gone() {
  local i
  for ((i = 0; i < 100; i++)); do
    [ -e "$1" ] || return 0
    sleep 0.1
  done
  echo "still there: $1"
  return 1
}

expect_eq() {
  [ "$1" = "$2" ] && return 0
  printf '%s\n  expected: %s\n  actual:   %s\n' "$3" "$2" "$1"
  return 1
}

# What C-y has Ghostty do: write the screen to a file in a directory of its own, in the temporary directory, and send
# F20, the file's path and a return
screen_file=
c_y() {
  screen_file="$(mktemp -d "$case_dir/tmp/XXXXXX")/screen.txt"
  screen > "$screen_file"
  t send-keys -H 1b 5b 33 34 7e
  t send-keys -l "$screen_file"
  t send-keys -H 0d
}

#  Tests
#-----------------------------------------------
test_program_keeps_running() {
  start <<EOF
i=0
while [ \$i -lt 30 ]; do
  i=\$((i + 1))
  echo "tick \$i"
  perl -MTime::HiRes=time -e 'printf "%.3f\n", time' >> "$case_dir/times"
  sleep 0.1
done
echo finished
sleep 60
EOF
  wait_for '^tick 5$' || return 1
  c_y
  wait_for '^fake nvim' || return 1
  sleep 1.5
  if screen | grep -q '^tick'; then
    echo "the program's output came while Neovim ran:"
    screen
    return 1
  fi
  t send-keys q
  wait_for '^finished$' || return 1
  expect_eq "$(screen | grep '^tick' | tr '\n' ' ')" "$(seq -f 'tick %g' 1 30 | tr '\n' ' ')" 'the ticks, after Neovim' &&
    awk 'NR > 1 && $1 - last > 0.5 { print "paused before tick " NR ": " $1 - last "s"; paused = 1 }
      { last = $1 } END { exit paused }' "$case_dir/times"
}

test_neovim_shows_the_file() {
  start <<'EOF'
echo 'on the screen'
sleep 60
EOF
  wait_for '^on the screen$' || return 1
  c_y
  wait_for '^fake nvim' || return 1
  t send-keys q
  wait_for '^on the screen$' || return 1
  expect_eq "$(sed -n 's/^args: //p' "$log")" "-n -M --cmd set nomodeline + -c call search('\\S', 'bcW') -- $screen_file" \
    "Neovim's arguments" &&
    expect_eq "$(sed -n 's/^file: //p' "$log")" 'on the screen' "the file's first line" &&
    wait_gone "${screen_file%/*}"
}

test_modes_set_again() {
  start <<'EOF'
printf '\033[?1h\033=\033[?2004h\033[?1000h\033[?1006h\033[?25l\033]2;the title\007'
stty raw -echo
cat -v
EOF
  wait_for_format '#{pane_title}' 'the title' || return 1
  c_y
  wait_for '^fake nvim' || return 1
  wait_for_format '#{pane_title}' 'screen.txt - NVIM' || return 1
  t send-keys q
  wait_for_format '#{alternate_on}' 0 || return 1
  local format='#{keypad_cursor_flag} #{keypad_flag} #{mouse_standard_flag} #{mouse_sgr_flag} #{cursor_flag} #{pane_title}'
  expect_eq "$(t display-message -p "$format")" '1 1 1 1 0 the title' "$format" || return 1
  # Bracketed paste: tmux pastes between ESC [200~ and ESC [201~
  t set-buffer pasted \; paste-buffer -p
  wait_for '^[[200~pasted^[[201~' 100 fixed
}

test_alternate_screen_redrawn() {
  start <<'EOF'
n=0
draw() {
  n=$((n + 1))
  printf '\033[H\033[2Jdrawn %s times' "$n"
}
printf '\033[?1049h'
trap draw WINCH
draw
while :; do sleep 0.1; done
EOF
  wait_for '^drawn 1 times' || return 1
  c_y
  wait_for '^fake nvim' || return 1
  t send-keys q
  wait_for '^drawn 2 times' || return 1
  expect_eq "$(t display-message -p '#{alternate_on}')" 1 'on the alternate screen'
}

test_c_y_in_neovim() {
  start <<'EOF'
echo text
sleep 60
EOF
  wait_for '^text$' || return 1
  c_y
  local shown="$screen_file"
  wait_for '^fake nvim' || return 1
  c_y
  wait_gone "${screen_file%/*}" || return 1
  expect_eq "$(grep -c '^key: 19$' "$log")" 1 'C-y keys Neovim got' || return 1
  [ -e "$shown" ] || {
    echo "the file Neovim shows is gone"
    return 1
  }
  t send-keys q
  wait_gone "${shown%/*}"
}

test_other_files_go_to_the_program() {
  start <<'EOF'
stty raw -echo
cat -v
EOF
  echo kept > "$case_dir/tmp/kept.txt"
  sleep 0.5
  t send-keys -H 1b 5b 33 34 7e
  t send-keys -l "$case_dir/tmp/kept.txt"
  t send-keys -H 0d
  wait_for "^[[34~$case_dir/tmp/kept.txt^M" 100 fixed || return 1
  [ -e "$case_dir/tmp/kept.txt" ] || {
    echo "the file is gone"
    return 1
  }
  # F20 alone, once no path comes
  t send-keys -H 1b 5b 33 34 7e
  wait_for '^M^[[34~' 50 fixed
}

test_keys_go_through_at_once() {
  start <<'EOF'
stty raw -echo
cat -v
EOF
  sleep 0.5
  # ESC alone is the escape key
  t send-keys -H 1b
  wait_for '^\^\[$' 5 || return 1
  t send-keys -H 1b 5b 41 61
  wait_for '^\^\[\^\[\[Aa$' 5
}

test_resize() {
  start <<'EOF'
trap 'stty size' WINCH
stty size
while :; do sleep 0.1; done
EOF
  wait_for '^30 100$' || return 1
  t resize-window -x 80 -y 20
  wait_for '^20 80$'
}

test_exit_status() {
  start <<'EOF'
exit 7
EOF
  wait_for_format '#{pane_dead_status}' 7
}

test_login_shell() {
  login=1 start <<'EOF'
echo "name: $0"
sleep 60
EOF
  wait_for '^name: -sh$'
}

#  Main
#-----------------------------------------------
failed=0
for test in $(declare -F | awk '$3 ~ /^test_/ { print $3 }'); do
  if output="$($test 2>&1)"; then
    echo "ok - ${test#test_}"
  else
    echo "not ok - ${test#test_}"
    printf '%s\n' "$output" | sed 's/^/  # /'
    failed=1
  fi
done
exit $failed
