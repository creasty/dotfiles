#!/usr/bin/env bash
#
# Verifies that the provisioning is reflected on this machine by running the behavioral tests in nix/tests/.
# The tests compare the machine with /etc/dotfiles/manifest.json, which the activated configuration wrote.
#
#   ./verify [bats options]           e.g. ./verify --filter java
#   ./verify --bench [bats options]   the benchmarks (tests tagged bench) alone, which other runs skip

set -eu
set -o pipefail

# Where flake.nix and shell/profile expect the clone
DOTFILES_PATH="$HOME/dotfiles"

load_envs() {
  # shellcheck source=/dev/null
  . "$DOTFILES_PATH/shell/profile"
}

# With bats and yq at the versions flake.lock pins
run_tests() {
  echo 'Verifying...'
  cd "$DOTFILES_PATH"
  nix shell "$DOTFILES_PATH#bats" "$DOTFILES_PATH#yq-go" --command \
    bats --timing --print-output-on-failure "$@" nix/tests
}

#=== Entrypoint
#==============================================================================================
main() {
  load_envs
  if [ "${1:-}" = --bench ]; then
    shift
    VERIFY_BENCH=1 run_tests --filter-tags bench "$@"
  else
    run_tests "$@"
  fi
}

main "$@"
