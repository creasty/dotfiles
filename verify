#!/usr/bin/env bash
#
# Verifies that the provisioning is reflected on this machine by running the behavioral tests in test/.
# The tests compare the machine with /etc/dotfiles/manifest.json, which the activated configuration wrote.
#
#   ./verify [bats options]    e.g. ./verify --filter java

set -eu
set -o pipefail

: "${DOTFILES_PATH:="$HOME/dotfiles"}"

load_envs() {
  # shellcheck source=/dev/null
  . "$DOTFILES_PATH/shell/profile"
}

# With bats and yq at the versions flake.lock pins
run_tests() {
  echo 'Verifying...'
  cd "$DOTFILES_PATH"
  nix shell "$DOTFILES_PATH#bats" "$DOTFILES_PATH#yq-go" --command \
    bats --timing --print-output-on-failure "$@" test
}

#=== Entrypoint
#==============================================================================================
main() {
  load_envs
  run_tests "$@"
}

main "$@"
