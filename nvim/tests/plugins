#!/bin/sh
# Installs and checks the plugins the suite runs against (nvim/flake.lock). See: plugins --help
# Where the plugins are installed: lazy.nvim's root, unless E2E_PLUGINS says otherwise.
E2E_PLUGINS=${E2E_PLUGINS:-${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy}
export E2E_PLUGINS
# nvim-treesitter builds parsers under stdpath('cache'): keep that out of yours.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/nvim-plugins.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/data/nvim"
XDG_DATA_HOME="$tmp/data" XDG_STATE_HOME="$tmp/state" XDG_CACHE_HOME="$tmp/cache" \
  "${NVIM_BIN:-nvim}" --clean -l "$(cd "$(dirname "$0")" && pwd)/plugins.lua" "$@"
