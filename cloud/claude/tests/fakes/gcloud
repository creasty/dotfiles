#!/usr/bin/env bash
# A fake of the gcloud commands gcloud-login.sh runs, for a login and what follows one, which the tests can't do with
# Google: its client and endpoints are the fake google-oauth's, at $FAKE_GOOGLE_OAUTH_URL, and it takes that fake's
# refresh token. Each call goes on a line of $CLOUDSDK_CONFIG/calls, and one that gets the placeholder token fails, on
# a line starting with "placeholder:".
# FAKE_GCLOUD_KEEP_ADC=1 has ADC's revoke keep its file, as it does after the CLI's revoke.

set -euo pipefail

mkdir -p "$CLOUDSDK_CONFIG"
account="$CLOUDSDK_CONFIG/account"
adc="$CLOUDSDK_CONFIG/application_default_credentials.json"

if [ -n "${CLOUDSDK_AUTH_ACCESS_TOKEN+x}" ]; then
  echo "placeholder: $*" >> "$CLOUDSDK_CONFIG/calls"
  exit 1
fi
echo "$*" >> "$CLOUDSDK_CONFIG/calls"

case "$*" in
  'config get auth/auth_host') echo "$FAKE_GOOGLE_OAUTH_URL/auth" ;;
  'config get auth/token_host') echo "$FAKE_GOOGLE_OAUTH_URL/token" ;;
  'config get auth/client_id') echo fake-client-id ;;
  'config get auth/client_secret') echo fake-client-secret ;;
  'auth activate-refresh-token user@example.com')
    printf 'Refresh token: ' >&2
    read -r token
    if [ "$token" != fake-refresh-token ]; then
      echo "ERROR: (gcloud.auth.activate-refresh-token) There was a problem refreshing your current auth tokens: ('invalid_grant: Bad Request')" >&2
      exit 1
    fi
    echo user@example.com > "$account"
    ;;
  'auth list --filter=status:ACTIVE --format=value(account)' | 'auth list --format=value(account)')
    cat "$account" 2> /dev/null || true
    ;;
  'auth application-default print-access-token')
    jq -e '.type == "authorized_user" and .refresh_token == "fake-refresh-token"' "$adc" > /dev/null 2>&1
    ;;
  'auth application-default revoke --quiet')
    [ -n "${FAKE_GCLOUD_KEEP_ADC:-}" ] || rm -f "$adc"
    ;;
  'auth revoke --all --quiet')
    rm -f "$account"
    ;;
  *)
    echo "fake gcloud: no such command: $*" >&2
    exit 2
    ;;
esac
