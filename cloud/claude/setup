#!/usr/bin/env bash
#
# Writes Claude Code's user files, home/claude/CLAUDE.md and settings.json and the skills in cloud/claude/skills/, into
# a cloud session's VM, and has its shells drop the placeholder token that keeps gcloud from using the account you log
# in with. The setup script of a Claude Code cloud environment downloads it and runs it, from DOTFILES_URL (README.md).

set -euo pipefail

# On a Mac, ~/.claude and ~/.bashrc link into the checkout, which writing them would overwrite
if [[ $(uname -s) != Linux ]]; then
  echo "cloud/claude/setup: for a cloud session's VM; ./apply links these files on a Mac" >&2
  exit 1
fi

# Where the repository's files are served from: a branch of it, which the cloud environment's setup script names, or
# the checkout's files, which the tests (tests/) serve
url="${DOTFILES_URL:-https://raw.githubusercontent.com/creasty/dotfiles/refs/heads/master}"

mkdir -p ~/.claude
curl -fsSL "$url/home/claude/CLAUDE.md" -o ~/.claude/CLAUDE.md
# CLAUDE_CODE_SHELL is the Nix profile's bash, which the VM doesn't have
curl -fsSL "$url/home/claude/settings.json" | jq 'del(.env.CLAUDE_CODE_SHELL)' > ~/.claude/settings.json

# The skills only cloud sessions need, a file at a time: the VM gets a 403 for an archive of a repository the session
# doesn't have
for file in gcloud-login/SKILL.md gcloud-login/scripts/gcloud-login.py; do
  curl -fsSL --create-dirs "$url/cloud/claude/skills/$file" -o ~/.claude/skills/"$file"
done
chmod +x ~/.claude/skills/gcloud-login/scripts/gcloud-login.py

# gcloud prefers the VM's placeholder CLOUDSDK_AUTH_ACCESS_TOKEN to your login, and only an unset removes it (README.md);
# it goes on ~/.bashrc's first line, above the return that skips the rest in a non-interactive shell
line='unset CLOUDSDK_AUTH_ACCESS_TOKEN'
# sed inserts nothing into an empty file
if [[ ! -s ~/.bashrc ]]; then
  echo "$line" >> ~/.bashrc
elif ! grep -qx "$line" ~/.bashrc; then
  sed -i "1i $line" ~/.bashrc
fi
