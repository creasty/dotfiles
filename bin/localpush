#!/usr/bin/env bash
#
# Shows a notification: localpush [<title> [<message>]]

set -euo pipefail

# An AppleScript string: its literals escape " and \ as JSON's do
string() {
  jq -n --arg s "$1" '$s'
}

script="display notification $(string "${2-}")"
if [ $# -gt 0 ]; then
  script+=" with title $(string "$1")"
fi

osascript -e "$script"
