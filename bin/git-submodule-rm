#!/usr/bin/env bash

set -euo pipefail

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  echo 'Not in git repository'
  exit 1
fi
cd "$(git rev-parse --show-toplevel)"

if ! [[ -e "$(pwd)/.gitmodules" ]]; then
  echo 'No .gitmodules found'
  exit 1
fi

if [[ $# -eq 0 ]]; then
  echo 'Usage: git submodule-rm <path ...>'
  exit 1
fi

for path in "$@"; do
  git rm --cached "$path"
  # The repository's config has a section once the submodule is initialized
  git config --local --remove-section "submodule.$path" 2> /dev/null || true
  git config -f .gitmodules --remove-section "submodule.$path"
done
