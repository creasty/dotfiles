#!/usr/bin/env bash
#
# Opens a directory in Finder, in a new tab unless the front window shows it:
#
#   finder [<dir>]            the current directory by default
#   finder :<port>[/<path>]   http://localhost:<port>[/<path>]
#   finder <arg>...           anything else, with open

set -euo pipefail

SCRIPT='
  on run argv
    set targetPath to (beginning of argv) as POSIX file

    tell application "Finder"
      activate

      set currentPath to (target of the front Finder window) as alias
      if currentPath is not targetPath as alias then
        tell application "System Events" to keystroke "t" using command down
      end if
      delay 0.3

      set target of the front Finder window to targetPath
    end tell
  end run
'

TARGET="${1:-.}"

if [[ "$TARGET" =~ ^:[0-9]+(/.+)?$ ]]; then
  open "http://localhost$TARGET"
elif [ -d "$TARGET" ]; then
  osascript -e "$SCRIPT" "$(cd "$TARGET" && pwd)/" > /dev/null
else
  open "$@"
fi
