{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 999,
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647",
    "CLAUDE_CODE_SHELL": "/run/current-system/sw/bin/bash",
    "CLAUDE_CODE_USER_DIALOG_TIMEOUT_MS": "0",
    "DISABLE_COST_WARNINGS": "1",
    "GIT_AUTHOR_NAME": "Yuki Iwanaga",
    "GIT_AUTHOR_EMAIL": "yuki@creasty.com",
    "LANG": "C.UTF-8"
  },
  "attribution": {
    "pr": "<!-- Generated with Claude Code -->",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "mcp__ccd_session_mgmt__set_remote_control"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "mcp-server-dev@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "askUserQuestionTimeout": "never",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "switchModelsOnFlag": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
