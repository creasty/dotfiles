# @see https://ghostty.org/docs/config/reference
#
# Neovim's GUI: Ghostty runs Neovim alone, an app of its own for Hammerspoon and the Spaces to tell from the terminal,
# kitty (config/kitty/kitty.conf).

#=== General
#==============================================================================================
# Neovim, through zsh, which puts Nix's profile on PATH
command = /bin/zsh -c 'exec nvim'
shell-integration = none

# close windows without asking, and start without the last ones
confirm-close-surface = false
window-save-state = never

#=== Key bindings
#==============================================================================================
# Neovim gets the keys, but Cmd+N (a new window) and Cmd+W (close it). C-z doesn't suspend it.
keybind = clear
keybind = super+n=new_window
keybind = super+w=close_surface
keybind = ctrl+z=ignore

#=== Appearance
#==============================================================================================
#  Window
#-----------------------------------------------
# maximized, under macOS's own title bar
maximize = true
macos-titlebar-style = native

# padding: what's left of a cell goes to the right and the bottom
window-padding-x = 6
window-padding-y = 6

#  Font
#-----------------------------------------------
# Menlo 12 (macOS's default), with 16% more between lines (glyphs centered) and the underline a little lower. Japanese
# in Hiragino Sans, named after it: otherwise Ghostty asks macOS for kanji only, and takes kana from any font that has
# them, e.g. a serif one (Mincho).
font-family = Menlo
font-family = Hiragino Sans W4
font-size = 12
adjust-cell-height = 16%
adjust-underline-position = 2

# as heavy as kitty draws them: Menlo thickened, and Japanese a weight up from macOS's fallback, W3 and W6 in bold
font-family-bold = Menlo
font-family-bold = Hiragino Sans W7
font-family-bold-italic = Menlo
font-family-bold-italic = Hiragino Sans W7
font-thicken = true
font-thicken-strength = 128

#  Colors
#-----------------------------------------------
background = #1b1b1b
foreground = #c0c0c0
cursor-color = #a8a8a8
cursor-text = #1a1a1a
