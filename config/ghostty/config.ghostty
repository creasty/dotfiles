# @see https://ghostty.org/docs/config/reference
#
# Alacritty running tmux (config/alacritty, config/tmux), with Ghostty's own tabs and splits in place of tmux's windows
# and panes: a tab holds splits, and the prefix key drives them.

#=== General
#==============================================================================================
# zsh, as tmux's default-shell (Ghostty starts it as a login shell)
command = /bin/zsh

# new tabs and windows start in the home directory, as tmux's new windows and Alacritty did, and splits in the
# directory of the pane they split
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false

# history of about 15000 lines, as tmux's history-limit: Ghostty limits it by memory, about 2 KB a line
scrollback-limit = 30000000

# the shell integration reports the directory to splits and marks the prompts, but term.zsh sets the title and the
# cursor stays a block. sudo keeps Ghostty's terminfo, and ssh gives remote hosts xterm-256color.
shell-integration-features = no-cursor,no-title,sudo,ssh-env

# close panes without asking, as tmux's kill-pane (Cmd+Z brings one back within 5 seconds)
confirm-close-surface = false

# quit with the last window, as Alacritty
quit-after-last-window-closed = true

# paste without asking: zsh has bracketed paste off (zshrc), which Ghostty would take as unsafe
clipboard-paste-protection = false

#=== Key bindings
#==============================================================================================
# Ghostty's own shortcuts (Cmd+C, Cmd+V, Cmd+T...) stay, as Alacritty's did

#  Prefix key
#-----------------------------------------------
# C-s, as tmux's; pressed twice, it goes to the program. Unlike tmux, a key without a binding goes there with it.
keybind = ctrl+s>ctrl+s=text:\x13

#  Copy & paste
#-----------------------------------------------
# copy mode (see "Copy mode")
keybind = ctrl+y=activate_key_table:copy

# paste
keybind = ctrl+s>p=paste_from_clipboard

#  Tab & split
#-----------------------------------------------
# tab, after the current one
keybind = ctrl+s>t=new_tab
keybind = ctrl+s>ctrl+b=previous_tab
keybind = ctrl+s>ctrl+n=next_tab

# split. v evens out the panes, as tmux's even-horizontal layout, and so does = (shift+= is = on JIS keyboards)
keybind = ctrl+s>s=new_split:down
keybind = ctrl+s>v=new_split:right
keybind = chain=equalize_splits
keybind = ctrl+s>==equalize_splits
keybind = ctrl+s>shift+==equalize_splits

# pane
keybind = ctrl+s>ctrl+h=goto_split:left
keybind = ctrl+s>ctrl+j=goto_split:down
keybind = ctrl+s>ctrl+k=goto_split:up
keybind = ctrl+s>ctrl+l=goto_split:right

# resize by about a cell: < > - +
keybind = ctrl+s>shift+comma=resize_split:left,7
keybind = ctrl+s>shift+period=resize_split:right,7
keybind = ctrl+s>-=resize_split:down,15
keybind = ctrl+s>shift++=resize_split:up,15

# close pane. Ghostty can't even out the other panes after it, as tmux's d did: C-s = does.
keybind = ctrl+s>d=close_surface
keybind = ctrl+s>c=close_surface

#  Copy mode
#-----------------------------------------------
# Scrolls and searches the history with vi's keys, as tmux's copy mode. Ghostty can't select text with the keyboard,
# so v opens the screen and its history in Neovim to select there. Other keys do nothing, and Cmd leaves copy mode
# for Ghostty's shortcuts.
keybind = copy/catch_all=ignore
keybind = copy/super+catch_all=deactivate_key_table

# scroll by lines, half pages and pages, and to the top and the bottom
keybind = copy/j=scroll_page_lines:1
keybind = copy/k=scroll_page_lines:-1
keybind = copy/arrow_down=scroll_page_lines:1
keybind = copy/arrow_up=scroll_page_lines:-1
keybind = copy/ctrl+e=scroll_page_lines:1
keybind = copy/ctrl+y=scroll_page_lines:-1
keybind = copy/ctrl+d=scroll_page_fractional:0.5
keybind = copy/ctrl+u=scroll_page_fractional:-0.5
keybind = copy/ctrl+f=scroll_page_down
keybind = copy/ctrl+b=scroll_page_up
keybind = copy/g=scroll_to_top
keybind = copy/shift+g=scroll_to_bottom

# to the previous and the next prompt, in place of paragraphs
keybind = copy/shift+{=jump_to_prompt:-1
keybind = copy/shift+}=jump_to_prompt:1

# search upward, as tmux's ?: type the text and Enter, then Escape goes back to n and N. Escape again clears it.
keybind = copy//=start_search
keybind = copy/shift+?=start_search
keybind = copy/n=navigate_search:next
keybind = copy/shift+n=navigate_search:previous
keybind = copy/escape=end_search

# select in Neovim: F20 has term.zsh open the file that Ghostty writes the screen to, at the prompt
keybind = copy/v=deactivate_key_table
keybind = chain=end_search
keybind = chain=scroll_to_bottom
keybind = chain=csi:34~
keybind = chain=write_screen_file:paste
keybind = chain=text:\r

# copy the selection (of the mouse), and leave
keybind = copy/y=copy_to_clipboard:plain
keybind = chain=deactivate_key_table
keybind = chain=end_search
keybind = chain=scroll_to_bottom
keybind = copy/enter=copy_to_clipboard:plain
keybind = chain=deactivate_key_table
keybind = chain=end_search
keybind = chain=scroll_to_bottom

# leave
keybind = copy/q=deactivate_key_table
keybind = chain=end_search
keybind = chain=scroll_to_bottom
keybind = copy/ctrl+c=deactivate_key_table
keybind = chain=end_search
keybind = chain=scroll_to_bottom

# switch tabs and panes, leaving copy mode on in this pane, as tmux
keybind = copy/ctrl+s>ctrl+b=previous_tab
keybind = copy/ctrl+s>ctrl+n=next_tab
keybind = copy/ctrl+s>ctrl+h=goto_split:left
keybind = copy/ctrl+s>ctrl+j=goto_split:down
keybind = copy/ctrl+s>ctrl+k=goto_split:up
keybind = copy/ctrl+s>ctrl+l=goto_split:right

#  Others
#-----------------------------------------------
# command palette, in place of tmux's command prompt (: is shift+: on US keyboards, and : on JIS ones)
keybind = ctrl+s>shift+:=toggle_command_palette
keybind = ctrl+s>:=toggle_command_palette

# reload the config
keybind = ctrl+s>r=reload_config

#=== Appearance
#==============================================================================================
#  Window
#-----------------------------------------------
# maximized, as Alacritty's startup_mode
maximize = true

# padding, as Alacritty's: what's left of a cell goes to the right and the bottom
window-padding-x = 6
window-padding-y = 6

# tabs in the title bar, at the top as tmux's status bar, in the terminal's font. term.zsh titles them with the name
# of the directory, as tmux's window list.
macos-titlebar-style = tabs
window-title-font-family = Menlo

# no size overlays while resizing
resize-overlay = never

#  Font
#-----------------------------------------------
# Menlo 12, as Alacritty (macOS's default), with the 2px of its offset between lines (glyphs centered)
font-family = Menlo
font-size = 12
adjust-cell-height = 2

#  Cursor
#-----------------------------------------------
# a steady block in the colors of the cell under it, as Alacritty's
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background

#  Colors
#-----------------------------------------------
# Alacritty's: the normal colors (0-7), then the bright ones (8-15)
background = #1b1b1b
foreground = #c0c0c0
palette = 0=#424242
palette = 1=#a57572
palette = 2=#a6b083
palette = 3=#d0b888
palette = 4=#8ca2b6
palette = 5=#a186a3
palette = 6=#9abbb6
palette = 7=#575757
palette = 8=#424242
palette = 9=#b56e6a
palette = 10=#a5b56b
palette = 11=#d8b775
palette = 12=#82a4c3
palette = 13=#b07bb4
palette = 14=#80c7bc
palette = 15=#575757

# selection in tmux's mode-style, and search matches in the colors of tmux's copy-mode-match-style (cyan) and
# copy-mode-current-match-style (magenta)
selection-foreground = #575757
selection-background = #262626
search-foreground = #424242
search-background = #9abbb6
search-selected-foreground = #424242
search-selected-background = #a186a3

#  Split
#-----------------------------------------------
# dividers in the color of tmux's pane borders, and the other panes not dimmed
split-divider-color = #262626
unfocused-split-opacity = 1
