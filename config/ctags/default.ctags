--recurse=yes

--fields=-s
--fields=+l
--fields=+n

--exclude=.git
--exclude=build
--exclude=dist
--exclude=tmp
--exclude=vendor
--exclude=node_modules

# Not JSON: lock files and generated schemas would flood the tags with its keys
--languages=-html,json

# Rails' associations and scopes, as the methods they define
--regex-ruby=/(^|;)[ \t]*(has_many|belongs_to|has_one|has_and_belongs_to_many)\(? *:([[:alnum:]_]+)/\3/f/
--regex-ruby=/(^|;)[ \t]*scope\(? *:([[:alnum:]_]+)/\2/f/

# GraphQL, which Universal Ctags has no parser for
--langdef=graphql
--langmap=graphql:.graphql
--regex-graphql=/^[ \t]*enum[ \t]+([_A-Za-z][_0-9A-Za-z]*)/\1/e,enum/
--regex-graphql=/^[ \t]*query[ \t]+([_A-Za-z][_0-9A-Za-z]*)/\1/q,query/
--regex-graphql=/^[ \t]*fragment[ \t]+([_A-Za-z][_0-9A-Za-z]*)/\1/f,fragment/
--regex-graphql=/^[ \t]*type[ \t]+([_A-Za-z][_0-9A-Za-z]*)/\1/t,type/
--regex-graphql=/^[ \t]*input[ \t]+([_A-Za-z][_0-9A-Za-z]*)/\1/i,input/
--regex-graphql=/^[ \t]*mutation[ \t]+([_A-Za-z][_0-9A-Za-z]*)/\1/m,mutation/
